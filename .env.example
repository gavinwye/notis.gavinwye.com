# Copy to .env for local `netlify dev`, and set the same values in
# Netlify → Site settings → Environment variables for production.

# Blob store name. Change it to namespace comments per project/site.
COMMENTS_STORE=comments

# Guards the DELETE (moderation / reset) endpoints. Set this to a long random
# string. If it is left UNSET, all DELETE requests are refused (fail closed).
# Send it as `Authorization: Bearer <token>` when moderating.
COMMENTS_ADMIN_TOKEN=change-me

# Optional CORS allowlist (comma-separated origins), e.g.
#   https://example.netlify.app,https://www.example.com
# If unset, the API allows any origin ("*"). Set it to lock writes to your site.
COMMENTS_ALLOWED_ORIGINS=
